# Copy to .env (never commit .env). Values are read at startup.
# eBay developer keys: developer.ebay.com → your name → Application Keysets → Production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# production (real listings) or sandbox (eBay's test data)
EBAY_ENVIRONMENT=production
# 0 turns off scheduled scans (manual "Run now" still works)
DEAL_HUNTER_SCHEDULER=1
